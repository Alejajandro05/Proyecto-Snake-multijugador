diff --git a/frontend/src/scenes/FoodFxMixin.js b/frontend/src/scenes/FoodFxMixin.js
new file mode 100644
index 0000000..d4e5f6a
--- /dev/null
+++ b/frontend/src/scenes/FoodFxMixin.js
@@ -0,0 +1,137 @@
+import { GRID_SIZE } from '@shared/GameConfig';
+
+const FOOD_FX_CONFIG = {
+    grape: {
+        color: 0x9b59b6,
+        text: '+3',
+    },
+    speed: {
+        color: 0xf1c40f,
+        text: 'SPEED',
+    },
+    poison: {
+        color: 0x2ecc71,
+        text: '-2',
+    },
+};
+
+function getFoodFxConfig(foodType) {
+    return FOOD_FX_CONFIG[foodType] ?? null;
+}
+
+export const FoodFxMixin = {
+    initFoodFx() {
+        this.foodFxLayer = this.add.container(0, 0).setDepth(30);
+        this.foodFxParticles = this.add.particles(0, 0, '__WHITE', {
+            speed: { min: 40, max: 130 },
+            scale: { start: 0.18, end: 0 },
+            alpha: { start: 1, end: 0 },
+            lifespan: 320,
+            quantity: 14,
+            gravityY: 0,
+            emitting: false,
+            blendMode: 'ADD',
+        });
+
+        this.foodFxLayer.add(this.foodFxParticles);
+        this.lastRenderedFoodFxKeys = new Map();
+    },
+
+    destroyFoodFx() {
+        this.lastRenderedFoodFxKeys?.clear?.();
+        this.foodFxLayer?.destroy(true);
+        this.foodFxLayer = null;
+        this.foodFxParticles = null;
+        this.handleLocalFoodFx = null;
+    },
+
+    getBoardCellCenter(boardX, boardY) {
+        const col = Math.floor(boardX / GRID_SIZE);
+        const row = Math.floor(boardY / GRID_SIZE);
+
+        return {
+            x: this.boardOffsetX + col * this.cellSize + this.cellSize * 0.5,
+            y: this.boardOffsetY + row * this.cellSize + this.cellSize * 0.5,
+        };
+    },
+
+    spawnFoodFx(food) {
+        const config = getFoodFxConfig(food?.type);
+        if (!config) return;
+
+        const { x, y } = this.getBoardCellCenter(food.x, food.y);
+
+        this.foodFxParticles.setTint(config.color);
+        this.foodFxParticles.explode(14, x, y);
+
+        const floatingText = this.add.text(x, y - this.cellSize * 0.15, config.text, {
+            fontFamily: 'Arial',
+            fontSize: `${Math.max(14, Math.floor(this.cellSize * 0.65))}px`,
+            color: `#${config.color.toString(16).padStart(6, '0')}`,
+            stroke: '#0b1020',
+            strokeThickness: 3,
+            fontStyle: 'bold',
+        })
+            .setOrigin(0.5)
+            .setDepth(31);
+
+        this.foodFxLayer.add(floatingText);
+
+        this.tweens.add({
+            targets: floatingText,
+            y: y - this.cellSize * 0.9,
+            alpha: 0,
+            duration: 500,
+            ease: 'Cubic.easeOut',
+            onComplete: () => floatingText.destroy(),
+        });
+    },
+
+    bindLocalFoodFx(engine) {
+        if (!engine?.events?.on) return;
+
+        this.handleLocalFoodFx = ({ food }) => {
+            if (!food || food.type === 'apple') return;
+            this.spawnFoodFx(food);
+        };
+
+        engine.events.on('playerEatFood', this.handleLocalFoodFx);
+    },
+
+    unbindLocalFoodFx(engine) {
+        if (!engine?.events?.off || !this.handleLocalFoodFx) return;
+        engine.events.off('playerEatFood', this.handleLocalFoodFx);
+        this.handleLocalFoodFx = null;
+    },
+
+    syncRemoteFoodFx(state) {
+        const players = Array.from(state?.players?.values?.() ?? []);
+
+        players.forEach((player) => {
+            const food = player?.lastEatenFood;
+            const currentKey = food ? `${player.id}:${food.type}:${food.x}:${food.y}:${food.score}` : null;
+            const previousKey = this.lastRenderedFoodFxKeys.get(player.id) ?? null;
+
+            if (currentKey && currentKey !== previousKey && food.type !== 'apple') {
+                this.spawnFoodFx(food);
+            }
+
+            if (currentKey) {
+                this.lastRenderedFoodFxKeys.set(player.id, currentKey);
+            } else {
+                this.lastRenderedFoodFxKeys.delete(player.id);
+            }
+        });
+    },
+};
